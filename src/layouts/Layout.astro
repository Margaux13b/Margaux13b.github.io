---
import Header from "../components/Header.astro";
import "../styles/global.scss";
import Particles from "../components/Particles.astro";
import SheikahFrame from "../components/SheikahFrame.astro";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Cinzel+Decorative:wght@700&family=Nunito:ital,wght@0,400;0,600;0,700;1,600;1,700&display=swap"
		/>
	</head><body>
		<div class="backdrop backdrop--sheikah" aria-hidden="true"></div>
		<Particles />
		<SheikahFrame />
		<Header />
		<main class="main">
			<slot />
		</main>
	</body>
</html>
