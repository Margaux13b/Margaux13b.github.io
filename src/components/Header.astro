---
import Menu from './Menu.astro';
---

<header class="header">
  <div class="header__nav">
    <Menu />
  </div>

  <a class="button button--cv header__cv" href="/cv-margaux.pdf" download>
    Télécharger mon CV (PDF)
  </a>
</header>

<style lang="scss">
  .header {
    position: sticky;
    top: 0.75rem;
    z-index: 5;
    backdrop-filter: blur(8px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 0.6rem 7rem;
    background: linear-gradient(to right, transparent, rgb(6 16 26 / 95%) 10%, rgb(6 16 26 / 95%) 90%, transparent);

    &::before,
    &::after {
      content: '';
      position: absolute;
      left: 5%;
      right: 5%;
      height: 1px;
      background: linear-gradient(to right, transparent, rgb(111 227 255 / 90%), transparent);
      box-shadow: 0 0 8px rgb(111 227 255 / 80%);
    }

    &::before {
      top: 0;
    }

    &::after {
      bottom: 0;
    }

    &__nav {
      grid-column: 2;
    }

    &__cv {
      grid-column: 3;
      justify-self: end;
    }
  }

  @media (max-width: 900px) {
    .header {
      grid-template-columns: 1fr;
      justify-items: center;
      padding: 0.75rem 1rem;
      position: relative;

      &__nav,
      &__cv {
        grid-column: 1;
        justify-self: center;
      }
    }
  }
</style>