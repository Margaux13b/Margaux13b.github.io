<canvas class="particles" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector('.particles') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const sansAnimation = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function redimensionner() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  function creerParticule() {
    return {
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      rayon: Math.random() * 2 + 0.5,
      vitesse: Math.random() * 0.3 + 0.1,
      oscillation: Math.random() * Math.PI * 2,
      opacite: Math.random() * 0.5 + 0.2,
    };
  }

  redimensionner();
  const particules = Array.from({ length: 60 }, creerParticule);
  window.addEventListener('resize', redimensionner);

  function dessiner() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (const p of particules) {
      p.y -= p.vitesse;
      p.oscillation += 0.01;
      p.x += Math.sin(p.oscillation) * 0.3;

      if (p.y < -10) {
        p.y = canvas.height + 10;
        p.x = Math.random() * canvas.width;
      }

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.rayon, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(111, 227, 255, ${p.opacite})`;
      ctx.shadowColor = 'rgba(111, 227, 255, 0.9)';
      ctx.shadowBlur = 8;
      ctx.fill();
    }

    if (!sansAnimation) requestAnimationFrame(dessiner);
  }

  dessiner();
</script>

<style>
  .particles {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
</style>