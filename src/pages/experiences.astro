---
import Layout from '../layouts/Layout.astro';
import Souvenirs from '../components/Souvenirs.jsx';
import { getImage } from 'astro:assets';          // 🆕
import { souvenirs } from '../data/souvenirs.js';  // 🆕

const souvenirsOptimises = await Promise.all(
  souvenirs.map(async (s) => ({
    ...s,
    vignette: (await getImage({ src: s.image, width: 500, format: 'webp' })).src,
    grande: (await getImage({ src: s.image, width: 900, format: 'webp' })).src,
  }))
);
---

<Layout
  title="Expériences · Margaux Blanvilin"
  description="Les expériences de Margaux Blanvilin en dehors de l'école : alternance en hôtellerie, handball et voyage en Asie."
>
  <div class="page page--wide">
    <h1>Expériences</h1>
    <p class="intro">Avant le code, il y a eu d'autres aventures. Sélectionne un souvenir pour le revivre.</p>

    <Souvenirs client:load souvenirs={souvenirsOptimises} />

    <div class="page__actions">
      <a class="button button--cv" href="/projets">Voir mes projets</a>
      <a class="button button--cv" href="/contact">Me contacter</a>
    </div>
  </div>
</Layout>

<style>
  .intro {
    margin-bottom: 2rem;
    opacity: 0.8;
  }
</style>